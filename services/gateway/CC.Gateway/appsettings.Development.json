{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": { "Path": "/api/v1/appointments/{**catch-all}" }
      },
      "feedback-route": {
        "ClusterId": "appointment-cluster",
        "Match": { "Path": "/api/v1/feedbacks/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/web-notifications/{**catch-all}" }
      },
      "practitioner-route": {
        "ClusterId": "practitioner-cluster",
        "Match": { "Path": "/api/v1/practitioners/{**catch-all}" }
      },
      "workSchedules-route": {
        "ClusterId": "practitioner-cluster",
        "Match": { "Path": "/api/v1/work-schedules/{**catch-all}" }
      },
      "handbook-route": {
        "ClusterId": "handbook-cluster",
        "Match": { "Path": "/api/v1/handbook/{**catch-all}" }
      }
    },
    "Clusters": {
      "appointment-cluster": {
        "Metadata": {
          "OpenApiName": "AppointmentService-v1",
          "OpenApiRoutes": "/openapi/v1.json"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5002/" }
        }
      },
      "notification-cluster": {
        "Metadata": {
          "OpenApiName": "NotificationService-v1",
          "OpenApiRoutes": "/openapi/v1.json"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5133/" }
        }
      },
      "practitioner-cluster": {
        "Metadata": {
          "OpenApiName": "PractitionerService-v1",
          "OpenApiRoutes": "/openapi/v1.json"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5001/" }
        }
      },
      "handbook-cluster": {
        "Metadata": {
          "OpenApiName": "HandbookService-v1",
          "OpenApiRoutes": "/openapi/v1.json"
        },
        "Destinations": {
          "destination1": { "Address": "http://localhost:5180/" }
        }
      }
    }
  }
}
