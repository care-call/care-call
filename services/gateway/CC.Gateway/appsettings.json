{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": { "Path": "/api/v1/appointments/{**catch-all}" }
      },
      "feedback-route": {
        "ClusterId": "appointment-cluster",
        "Match": { "Path": "/api/v1/feedbacks/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/web-notifications/{**catch-all}" }
      },
      "practitioner-route": {
        "ClusterId": "practitioner-cluster",
        "Match": { "Path": "/api/v1/practitioners/{**catch-all}" }
      },
      "work-schedules-route": {
        "ClusterId": "practitioner-cluster",
        "Match": { "Path": "/api/v1/work-schedules/{**catch-all}" }
      },
      "handbook-route": {
        "ClusterId": "handbook-cluster",
        "Match": { "Path": "/api/v1/handbook/{**catch-all}" }
      }
    },
    "Clusters": {
      "appointment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://appointment:8080/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://notification:8080/" }
        }
      },
      "practitioner-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://practitioner:8080/" }
        }
      },
      "handbook-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://handbook:8080/" }
        }
      }
    }
  }
}
